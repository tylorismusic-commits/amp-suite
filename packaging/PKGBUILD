# Maintainer: tylor <tylorismusic@users.noreply.github.com>
pkgname=amp-suite
pkgver=0.2.0
pkgrel=1
_tag=0.2.0-alpha.7
pkgdesc="Seven-amp guitar suite for Linux (CLAP + LV2)"
arch=('x86_64')
url="https://github.com/tylorismusic-commits/amp-suite"
license=('GPL-3.0-or-later')
depends=('cairo' 'freetype2' 'libx11' 'lv2' 'libsamplerate')
makedepends=('cmake' 'pkgconf' 'lilv' 'libxtst' 'xorg-server-xvfb')
source=("$pkgname-$_tag.tar.gz::$url/archive/v$_tag.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$_tag" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build -j"$(nproc)"
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
